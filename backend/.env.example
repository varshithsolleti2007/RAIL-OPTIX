PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/railway_block_planning

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Intelligence Service (Python/FastAPI) base URL - used once the ML gateway is wired up.
ML_SERVICE_URL=http://localhost:8000

# Used only by src/scripts/seedAdmin.js to bootstrap the first admin user.
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_EMAIL=admin@railway.local
SEED_ADMIN_PASSWORD=change_this_password
